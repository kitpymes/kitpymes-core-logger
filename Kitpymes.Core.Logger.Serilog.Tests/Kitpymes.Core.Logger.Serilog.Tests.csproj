<Project Sdk="Microsoft.NET.Sdk">
  
  <Import Project="$(KitpymesRoot)docs/props/Common.Build.props" Condition="Exists('$(KitpymesRoot)docs/props/Common.Build.props')" />

  <ItemGroup>
    <ProjectReference Include="$(KitpymesRoot)Kitpymes.Core.Logger.Abstractions\Kitpymes.Core.Logger.Abstractions.csproj" />
    <ProjectReference Include="$(KitpymesRoot)Kitpymes.Core.Logger.Serilog\Kitpymes.Core.Logger.Serilog.csproj" PrivateAssets="All" />
    <ProjectReference Include="$(KitpymesRoot)Kitpymes.Core.Logger\Kitpymes.Core.Logger.csproj" PrivateAssets="All" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.1" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <EmbeddedResource Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <!-- Obsoletos de la 2.3.0 (se quitan en la 3.0.0): la librería y sus pruebas los siguen usando. -->
    <NoWarn>$(NoWarn);KPY0009;KPY0010;KPY0011</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Firmado como la librería: ve sus tipos internos (InternalsVisibleTo con clave). -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(KitpymesRoot)docs\signassembly\SignStrong.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

</Project>