<Project Sdk="Microsoft.NET.Sdk">
  
  <Import Project="$(KitpymesRoot)docs/props/Common.Build.props" Condition="Exists('$(KitpymesRoot)docs/props/Common.Build.props')" />
  <Import Project="$(KitpymesRoot)docs/props/Pack.Build.props" Condition="Exists('$(KitpymesRoot)docs/props/Pack.Build.props')" />

  <ItemGroup>
    <ProjectReference Include="$(KitpymesRoot)Kitpymes.Core.Logger.Abstractions\Kitpymes.Core.Logger.Abstractions.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Serilog.Formatting.Compact" Version="2.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="1.5.0" />
    <PackageReference Include="Serilog.Sinks.Email" Version="4.2.1" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="6.5.0" />
    <!-- Serilog como proveedor de Microsoft.Extensions.Logging (ILogger<T>), desde la 2.3.0. -->
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <!-- Serilog.Sinks.MSSqlServer 6.5.0 trae Microsoft.Data.SqlClient 5.0.1 y, con él, Azure.Identity 1.6.0 y
         System.IdentityModel.Tokens.Jwt 6.21.0, con vulnerabilidades conocidas (GHSA-98g6-xh36-x2p7, GHSA-5mfx-4wcx-rv27,
         GHSA-wvxc-855f-jvrv, GHSA-m5vv-6r4h-3vj9, GHSA-59j7-ghrg-fj52). Se fijan versiones corregidas: llegan también
         a quien instala el paquete. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <!-- MimeKit 4.16 (por MailKit, en Serilog.Sinks.Email) trae System.Security.Cryptography.Pkcs 10.0.0, con
         GHSA-846f-f764-76mx (alta) y GHSA-2fmv-rv2c-59x7 (moderada), corregidas en la 10.0.13. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los tests prueban la ocultación de datos sensibles por dentro (fallo cerrado incluido). -->
    <InternalsVisibleTo Include="Kitpymes.Core.Logger.Serilog.Tests" Key="" />
  </ItemGroup>

  <ItemGroup>
    <!-- Desde la 3.0.0 no usa ASP.NET Core: Common.Build.props lo mete en todos los proyectos y un FrameworkReference
         llega a quien instala el paquete. -->
    <FrameworkReference Remove="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>